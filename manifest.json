{
  "name": "9128Controller",
  "version": "0.0.0.9",
  "manifest_version": 3,
  "description": "Control 9128 Live with a browser extension.",
  "homepage_url": "https://github.com/annoyingmouse/9128Controller",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "9128 Live is not open"
  },
  "background": {
    "service_worker": "js/controller.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://9128.live/*",
    "https://embed.radio.co/player/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://embed.radio.co/player/*"
      ],
      "js": [
        "js/injected.js"
      ],
      "all_frames": true
    }
  ]
}
